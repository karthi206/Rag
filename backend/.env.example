# ─── Model settings ───────────────────────────────────────────
MODEL_NAME=phi3
EMBED_MODEL=all-MiniLM-L6-v2
RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
OLLAMA_BASE=http://localhost:11434

# ─── Prompts ────────────────────────────────────────────────────
# Name of the file (without .txt) inside app/prompts/ to use.
PROMPT_VERSION=qa_prompt_v1

# ─── RAG hyper-parameters ─────────────────────────────────────
K_RETRIEVE=4
CHUNK_SIZE=700
CHUNK_OVERLAP=100
MAX_HISTORY_TURNS=5

# Minimum reranker confidence score required before the AI is allowed
# to answer at all. Below this, the app auto-refuses instead of guessing.
MIN_RERANK_SCORE=0.0

# ─── CORS (comma-separated list of allowed frontend origins) ──
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ─── Storage paths (relative to backend/) ────────────────────
VECTORSTORE_DIR=vectorstore
DOCUMENTS_DIR=documents
